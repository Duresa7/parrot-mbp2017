#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		udevadm control --reload || true
	fi
fi
# Enrolled-finger keybags under /var/lib/t1bridge are deliberately kept on
# purge; delete them by hand if you really want to start over.

exit 0
